{
  "$comment": "被禁 SDK 规则（技术方案第 6.2 节 C1）。外部模型只允许 OpenAI Responses 与 Anthropic Messages。forbidden 为被禁包名（支持 \"@scope/*\" 通配）；enforceCore 为 false 时 agent-core/ 中的发现只告警（Core 两协议裁剪已合入，现为 true）。importGraph：导入图入口（glob，相对仓库根）；required 为 true 的入口必须存在，其余入口在 --strict（CI 构建之后）时必须存在。sbom：scripts/generate-sbom.mjs 输出目录与必需文件，core 中列出的文件按 Core 处理。",
  "forbidden": [
    "@google/*",
    "@google-cloud/*",
    "google-auth-library",
    "@aws-sdk/client-bedrock",
    "@aws-sdk/client-bedrock-runtime",
    "@aws-sdk/client-bedrock-agent-runtime",
    "@anthropic-ai/bedrock-sdk",
    "@anthropic-ai/vertex-sdk",
    "@mistralai/*",
    "@azure/openai",
    "@azure-rest/ai-inference",
    "cohere-ai",
    "groq-sdk",
    "ollama"
  ],
  "enforceCore": true,
  "importGraph": [
    {
      "name": "前端页面",
      "entries": ["apps/desktop/src/app/**/*.tsx", "apps/desktop/src/app/**/*.ts"],
      "exclude": ["**/*.test.ts", "**/*.test.tsx"],
      "aliases": {
        "@/": "apps/desktop/src/"
      },
      "required": true
    },
    {
      "name": "第一方扩展（源码）",
      "entries": ["packages/extensions/src/index.ts"],
      "required": true
    },
    {
      "name": "第一方扩展（primus-bundle.js）",
      "entries": ["dist/agent-core/extensions/primus-bundle.js"],
      "hint": "先运行 pnpm build:extensions"
    },
    {
      "name": "Agent Core（打包前，决定打包内容）",
      "entries": [
        "agent-core/packages/coding-agent/dist/rpc-entry.js",
        "agent-core/packages/coding-agent/dist/cli.js"
      ],
      "core": true,
      "hint": "先运行 pnpm build:core"
    },
    {
      "name": "Agent Core（dist/agent-core 产物）",
      "entries": ["dist/agent-core/rpc-entry.js", "dist/agent-core/cli.js"],
      "core": true,
      "hint": "先运行 pnpm build:core"
    }
  ],
  "sbom": {
    "dir": "dist/sbom",
    "required": ["primus-workspace.cdx.json", "agent-core.cdx.json"],
    "core": ["agent-core.cdx.json"]
  }
}
