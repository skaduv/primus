{
  "providers": {
    "dev-openai": {
      "name": "开发 OpenAI Responses",
      "baseUrl": "https://example.com/v1",
      "api": "openai-responses",
      "apiKey": "$PRIMUS_DEV_OPENAI_API_KEY",
      "models": [
        {
          "id": "<模型 id>",
          "name": "<模型 id>",
