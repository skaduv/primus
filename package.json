{
  "name": "primus",
  "private": true,
  "description": "乾元（Primus）桌面 Agent 应用 monorepo",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "pnpm --filter @primus/desktop tauri dev",
    "dev:web": "pnpm --filter @primus/desktop dev",
    "build:core": "node scripts/build-core.mjs",
    "smoke:core": "node scripts/smoke-core-rpc.mjs",
    "smoke:core:dist": "node scripts/smoke-core-rpc.mjs --dist",
    "build:extensions": "pnpm --filter @primus/extensions build",
    "build:sbom": "node scripts/generate-sbom.mjs",
    "build:msi": "node scripts/build-msi.mjs",
    "build": "pnpm build:core && pnpm build:extensions && pnpm --filter @primus/desktop tauri build --no-bundle",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @primus/e2e test",
    "check:tauri-imports": "node scripts/check-tauri-imports.mjs",
    "check:forbidden-sdk": "node scripts/check-forbidden-sdk.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
