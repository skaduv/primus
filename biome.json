{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**/*.{ts,tsx,mts,js,mjs,cjs,json,jsonc,css}",
      "!agent-core",
      "!**/dist",
      "!**/out",
      "!**/.next",
      "!**/target",
      "!**/src-tauri/gen",
      "!apps/desktop/src/components/ui/glass.tsx",
      "!apps/desktop/src/components/ui/glass-motion.ts",
      "!apps/desktop/src/components/ui/glass-surface.tsx",
      "!apps/desktop/src/components/ui/glass-webgl.ts",
      "!apps/desktop/src/components/ui/glass-button.tsx",
      "!apps/desktop/src/components/ui/glass-switch.tsx",
      "!apps/desktop/src/components/ui/glass-slider.tsx"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  }
}
