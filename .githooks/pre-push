#!/bin/sh
# 推送前用 CodeRabbit CLI 本地预审已提交改动（scripts/cr-prereview.mjs）。
# 启用：pnpm hooks:install；跳过：PRIMUS_SKIP_CR=1 git push，或 git push --no-verify。
# 只删除远端分支时不审查。
zero=0000000000000000000000000000000000000000
need=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [ "$local_sha" != "$zero" ]; then need=1; fi
done
[ "$need" = 1 ] || exit 0
exec node scripts/cr-prereview.mjs
