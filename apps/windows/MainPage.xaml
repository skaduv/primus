<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Primus.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Primus"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="MainPage_Loaded"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid
            x:Name="MainExperience"
            IsHitTestVisible="False"
            Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="40,16,40,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
                <Border
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource PrimusGlassSubtleBrush}"
                    BorderBrush="{ThemeResource PrimusGlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20">
                    <Image
                        Width="42"
                        Height="42"
                        AutomationProperties.Name="Primus AI logo"
                        Opacity="0.72"
                        Source="/Assets/PrimusLogo.png"
                        Stretch="Uniform" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="28"
                    FontWeight="Normal"
                    Text="我们应该在winui中做些什么？" />
            </StackPanel>

            <Grid
                Grid.Row="1"
                MaxWidth="820"
                Margin="28,0,28,28"
                HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Height="42"
                    Margin="12,0,12,-10"
                    Padding="14,0"
                    Background="{ThemeResource PrimusGlassSubtleBrush}"
                    BorderBrush="{ThemeResource PrimusGlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE8B7;" />
                        <TextBlock
                            FontSize="14"
                            Text="winui" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Padding="18,16,16,12"
                    Background="{ThemeResource PrimusGlassSurfaceBrush}"
                    BorderBrush="{ThemeResource PrimusGlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="26"
                    Translation="0,0,24">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox
                            x:Name="PromptBox"
                            MinHeight="58"
                            MaxHeight="96"
                            Padding="2,0"
                            AcceptsReturn="True"
                            AutomationProperties.Name="输入消息"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="15"
                            PlaceholderForeground="{ThemeResource PrimusMutedTextBrush}"
                            PlaceholderText="随心输入"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top">
                            <TextBox.Resources>
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush
                                    x:Key="TextControlBorderBrushFocused"
                                    Color="Transparent" />
                                <SolidColorBrush
                                    x:Key="TextControlBackgroundFocused"
                                    Color="Transparent" />
                                <SolidColorBrush
                                    x:Key="TextControlBackgroundPointerOver"
                                    Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>

                        <Grid
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Width="34"
                                Height="34"
                                Padding="0"
                                AutomationProperties.Name="添加内容"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="17"
                                ToolTipService.ToolTip="添加内容">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="16"
                                    Glyph="&#xE710;" />
                            </Button>

                            <Button
                                Grid.Column="1"
                                Height="34"
                                Padding="8,0"
                                AutomationProperties.Name="完全访问"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{ThemeResource PrimusAccentBrush}">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="14"
                                        Glyph="&#xE7BA;" />
                                    <TextBlock
                                        FontSize="14"
                                        Text="完全访问" />
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Column="3"
                                Height="34"
                                Padding="8,0"
                                AutomationProperties.Name="选择模型"
                                Background="Transparent"
                                BorderThickness="0">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <TextBlock
                                        FontSize="14"
                                        Text="DeepSeek V4.1 Flash  极高" />
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="11"
                                        Foreground="{ThemeResource PrimusMutedTextBrush}"
                                        Glyph="&#xE70D;" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="SendButton"
                                Grid.Column="4"
                                Width="36"
                                Height="36"
                                Padding="0"
                                AutomationProperties.Name="发送消息"
                                Background="{ThemeResource PrimusSendBrush}"
                                BorderThickness="0"
                                CornerRadius="18"
                                Foreground="{ThemeResource PrimusSendForegroundBrush}"
                                ToolTipService.ToolTip="发送消息">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="17"
                                    Glyph="&#xE74A;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid
            x:Name="SplashOverlay"
            Background="Transparent"
            IsHitTestVisible="False">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Image
                    Width="180"
                    Height="180"
                    AutomationProperties.Name="Primus 启动 Logo"
                    Source="/Assets/PrimusLogo.png"
                    Stretch="Uniform" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Opacity="0.64"
                    Text="Primus" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
