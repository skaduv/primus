<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Primus.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Primus">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush
                        x:Key="PrimusThemeScrimBrush"
                        Color="#66080C14" />
                    <SolidColorBrush
                        x:Key="PrimusGlassSurfaceBrush"
                        Color="#D91A1F28" />
                    <SolidColorBrush
                        x:Key="PrimusGlassSubtleBrush"
                        Color="#661A1F28" />
                    <SolidColorBrush
                        x:Key="PrimusGlassBorderBrush"
                        Color="#33FFFFFF" />
                    <SolidColorBrush
                        x:Key="PrimusMutedTextBrush"
                        Color="#A8FFFFFF" />
                    <SolidColorBrush
                        x:Key="PrimusAccentBrush"
                        Color="#FFB47D" />
                    <SolidColorBrush
                        x:Key="PrimusControlBrush"
                        Color="#261A1F28" />
                    <SolidColorBrush
                        x:Key="PrimusSendBrush"
                        Color="#FFD0DBE8" />
                    <SolidColorBrush
                        x:Key="PrimusSendForegroundBrush"
                        Color="#FF1A1F28" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush
                        x:Key="PrimusThemeScrimBrush"
                        Color="#00000000" />
                    <SolidColorBrush
                        x:Key="PrimusGlassSurfaceBrush"
                        Color="#D8FBFCFE" />
                    <SolidColorBrush
                        x:Key="PrimusGlassSubtleBrush"
                        Color="#80F1F4F7" />
                    <SolidColorBrush
                        x:Key="PrimusGlassBorderBrush"
                        Color="#280E2740" />
                    <SolidColorBrush
                        x:Key="PrimusMutedTextBrush"
                        Color="#99000000" />
                    <SolidColorBrush
                        x:Key="PrimusAccentBrush"
                        Color="#B65312" />
                    <SolidColorBrush
                        x:Key="PrimusControlBrush"
                        Color="#140E2740" />
                    <SolidColorBrush
                        x:Key="PrimusSendBrush"
                        Color="#8C5C6675" />
                    <SolidColorBrush
                        x:Key="PrimusSendForegroundBrush"
                        Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
