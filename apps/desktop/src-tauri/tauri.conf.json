{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Primus",
  "mainBinaryName": "Primus",
  "identifier": "com.primus.desktop",
  "version": "0.0.0",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm next dev",
    "beforeBuildCommand": "pnpm next build"
  },
  "app": {
    "windows": [
      {
        "title": "乾元 Primus",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
