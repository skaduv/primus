{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Primus",
  "mainBinaryName": "Primus",
  "identifier": "com.primus.desktop",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm next dev",
    "beforeBuildCommand": "pnpm next build"
  },
  "app": {
    "windows": [
      {
        "title": "乾元 Primus",
        "width": 1120,
        "height": 720,
        "minWidth": 396,
        "center": true,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": { "effects": ["acrylic"] },
        "label": "main",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; frame-src 'self' blob: http://primus-preview.localhost primus-preview:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": false,
    "publisher": "乾元 Primus",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 乾元 Primus",
    "shortDescription": "乾元 Primus 桌面 Agent"
  }
}
