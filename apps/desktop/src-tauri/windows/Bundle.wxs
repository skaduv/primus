<?xml version="1.0" encoding="utf-8"?>
<!--
  乾元 Primus exe 安装程序 PrimusSetup_<ver>_<x64|arm64>_zh-CN.exe（WiX 7 Burn，ADR 0011、0012）。每个架构一个，
  各内嵌同架构的一个 MSI。由 scripts/build-setup-exe.mjs 构建：

    wix build Bundle.wxs -arch x86 -acceptEula wix7 -ext WixToolset.BootstrapperApplications.wixext
      -ext WixToolset.Util.wixext -d ProductVersion=<与 MSI 相同的 主.次.修订.构建> -d PrimusVersion=<SemVer>
      -d ShellDir=<apps/desktop/src-tauri> -d Arch=<x64|arm64> -d Msi=<Primus_<ver>_<arch>_zh-CN.msi>

  为什么要有它：部分电脑的 .msi 文件关联被改坏（双击提示“Windows 无法识别此类型的文件”或打不开）。exe 由 Burn 直接调用
  Windows Installer API 安装内嵌的 MSI，不经文件关联。

  界面（ADR 0012）：exe 自己画全部界面（setup-theme.xml + bundle-zh-CN.wxl），MSI 不显示内部界面、只由 Burn 汇报进度。
  页面与 MSI 直接安装时的界面（Primus.wxs 的 PrimusUI）一一对应：准备安装（隐私政策、同意、安装位置）→ 正在安装 → 完成。
  以前 exe 先显示自己的“欢迎 / 安装”页，再在另一个窗口里弹出 MSI 的整套向导，两个窗口来回切换、进度页在后面重绘，
  看起来一直闪；现在始终只有一个窗口。
  - 安装位置：默认 C:\Program Files\Primus；已装过 MSI 版（HKLM\Software\Primus\InstallDir）或要从旧 NSIS 版迁移时
    沿用原目录且不可更改（与 MSI 的逻辑相同），经 MsiProperty 作为 INSTALLFOLDER 传给 MSI
  - 完成页的“立即启动”由 exe 的界面进程（安装者本人、未提权）启动 Primus，不会以管理员身份运行
  - 两个 exe 的引擎都是 x86：x64 与 ARM64（经 x86 仿真）的 Windows 都能运行它，下错架构时能用中文说明原因，
    而不是 Windows 的“此应用无法在你的电脑上运行”。32 位 Windows 同样由 bal:Condition 拦下
  - 架构判断用 Burn 的 NativeMachine（0xAA64 = 43620 为 ARM64）：x64 版在 ARM64 电脑上拒绝安装、提示改用 arm64 版
    （否则会装上经仿真运行的 x64 版）；arm64 版只在 ARM64 电脑上安装。Windows 10 1709 之前没有 NativeMachine，
    这些版本没有 ARM64：x64 版照常安装，arm64 版拒绝
  - MSI 是 Permanent：Burn 只在有可卸载的包时才登记 bundle，因此 exe 不在“应用和功能”中留下自己的条目，
    已装好的就是 MSI 本身（Visible="yes"）。之后的应用内自动更新、卸载、PrimusUpdate 服务都与直接装 MSI 完全相同；
    DisableModify / DisableRemove 再兜底：即使因重启待定等原因留下登记，也不在“应用和功能”中显示
  - Cache="remove"：装完不在 Package Cache 中保留 MSI 副本（与从下载目录直接装 MSI 一样）
  - 仍给 MSI 传 PRIMUS_BUNDLE=1（MSI 的界面不会在 Burn 下显示；保留以兼容发布工作流对 PRIMUS_BUNDLE 的检查）
  UpgradeCode 与 MSI 的不同，两个架构共用，一经发布永不改变。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="乾元 Primus" Manufacturer="乾元 Primus" Version="$(ProductVersion)"
          UpgradeCode="FD216D87-9A80-4208-A28D-FA4B80241F96"
          IconSourceFile="$(ShellDir)\icons\icon.ico"
          DisableModify="yes" DisableRemove="yes">
    <BootstrapperApplication>
      <!-- 自定义主题（与 MSI 界面同一套设计）；隐私政策与 MSI 用同一个 Privacy.rtf，logo.png 是页眉右侧的标志 -->
      <bal:WixStandardBootstrapperApplication Theme="rtfLargeLicense"
                                              ThemeFile="$(ShellDir)\windows\setup-theme.xml"
                                              LocalizationFile="$(ShellDir)\windows\bundle-zh-CN.wxl"
                                              LicenseFile="$(ShellDir)\windows\Privacy.rtf"
                                              LogoFile="$(ShellDir)\windows\art\setup-logo.png"
                                              LaunchTarget="[InstallFolder]\Primus.exe"
                                              LaunchWorkingFolder="[InstallFolder]"
                                              SuppressOptionsUI="yes" SuppressRepair="yes" />
    </BootstrapperApplication>

    <!-- 页眉显示的版本（SemVer，与 MSI 界面一致；Burn 的版本是四段数字） -->
    <Variable Name="PrimusVersion" Value="$(PrimusVersion)" />

    <!-- 安装位置：默认 Program Files\Primus；沿用已安装的 MSI 版或旧 NSIS 版的目录（与 Primus.wxs 的 AppSearch 相同） -->
    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles64Folder]Primus" bal:Overridable="yes" />
    <util:RegistrySearch Id="PrimusPreviousFolderSearch" Variable="PrimusPreviousFolder" Result="value"
                         Root="HKLM" Key="Software\Primus" Value="InstallDir" Bitness="always64" />
    <util:RegistrySearch Id="PrimusNsisUninstallerSearch" Variable="PrimusNsisUninstaller" Result="value"
                         Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Primus"
                         Value="UninstallString" Bitness="always64" />
    <util:RegistrySearch Id="PrimusNsisFolderSearch" Variable="PrimusNsisFolder" Result="value"
                         Root="HKLM" Key="Software\乾元 Primus\Primus" Bitness="always64" />
    <SetVariable Id="UseNsisFolder" Variable="InstallFolder" Value="[PrimusNsisFolder]" After="PrimusNsisFolderSearch"
                 Condition="PrimusNsisUninstaller AND PrimusNsisFolder AND NOT PrimusPreviousFolder" />
    <SetVariable Id="UsePreviousFolder" Variable="InstallFolder" Value="[PrimusPreviousFolder]" After="UseNsisFolder"
                 Condition="PrimusPreviousFolder" />
    <SetVariable Id="LockFolder" Variable="PrimusFolderLocked" Value="1" After="UsePreviousFolder"
                 Condition="PrimusPreviousFolder OR (PrimusNsisUninstaller AND PrimusNsisFolder)" />

    <bal:Condition Condition="VersionNT64"
                   Message="乾元 Primus 只支持 64 位 Windows（x64 或 ARM64），这台电脑是 32 位系统，无法安装。" />
<?if $(Arch) = "x64" ?>
    <bal:Condition Condition="NOT (NativeMachine = 43620)"
                   Message="这台电脑是 ARM64 架构，请改用 ARM64 版安装程序（文件名中带 arm64 的 PrimusSetup）。" />
<?elseif $(Arch) = "arm64" ?>
    <bal:Condition Condition="NativeMachine = 43620"
                   Message="这台电脑不是 ARM64 架构，请改用 x64 版安装程序（文件名中带 x64 的 PrimusSetup）。" />
<?else?>
    <?error Arch 只能是 x64 或 arm64 ?>
<?endif?>

    <Chain>
      <!-- 不显示 MSI 自己的界面（没有 bal:DisplayInternalUICondition）：全程只有 exe 这一个窗口 -->
      <MsiPackage Id="Primus" SourceFile="$(Msi)" Compressed="yes" Permanent="yes" Visible="yes" Cache="remove">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="PRIMUS_BUNDLE" Value="1" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
