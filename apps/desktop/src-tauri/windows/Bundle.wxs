<?xml version="1.0" encoding="utf-8"?>
<!--
  乾元 Primus 通用安装程序 PrimusSetup_<ver>_zh-CN.exe（WiX 7 Burn，ADR 0011）。由 scripts/build-setup-exe.mjs 构建：

    wix build Bundle.wxs -arch x86 -acceptEula wix7 -ext WixToolset.BootstrapperApplications.wixext
      -d ProductVersion=<与 MSI 相同的 主.次.修订.构建> -d ShellDir=<apps/desktop/src-tauri>
      -d X64Msi=<Primus_<ver>_x64_zh-CN.msi> -d Arm64Msi=<Primus_<ver>_arm64_zh-CN.msi>

  为什么要有它：部分电脑的 .msi 文件关联被改坏（双击提示“Windows 无法识别此类型的文件”或打不开）。exe 由 Burn 直接调用
  Windows Installer API 安装内嵌的 MSI，不经文件关联；一个 exe 同时适用于 x64 与 ARM64。

  - 引擎为 x86：x64 与 ARM64（经 x86 仿真）的 Windows 都能运行；32 位 Windows 由 bal:Condition 拦下并给出中文说明
  - 按本机原生架构（NativeMachine：0xAA64 = 43620 为 ARM64）只安装一个 MSI；Windows 10 1709 之前没有 NativeMachine，
    这些版本没有 ARM64，按 x64 处理
  - 安装界面就是 MSI 自己的界面（bal:DisplayInternalUICondition）：隐私政策、选择安装目录（约束 C2）与原来一致
  - 两个 MSI 都是 Permanent：Burn 只在有可卸载的包时才登记 bundle，因此 exe 不在“应用和功能”中留下自己的条目，
    已装好的就是 MSI 本身（Visible="yes"）。之后的应用内自动更新、卸载、PrimusUpdate 服务都与直接装 MSI 完全相同；
    DisableModify / DisableRemove 再兜底：即使因重启待定等原因留下登记，也不在“应用和功能”中显示
  - Cache="remove"：装完不在 Package Cache 中保留 MSI 副本（与从下载目录直接装 MSI 一样）
  - 经 exe 安装时传 PRIMUS_BUNDLE=1：MSI 界面在 Burn 的提权进程中运行，完成页的“立即启动”会以管理员身份拉起 Primus，
    所以 Primus.wxs 在此时不显示该勾选框
  UpgradeCode 与 MSI 的不同，一经发布永不改变。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="乾元 Primus" Manufacturer="乾元 Primus" Version="$(ProductVersion)"
          UpgradeCode="FD216D87-9A80-4208-A28D-FA4B80241F96"
          IconSourceFile="$(ShellDir)\icons\icon.ico"
          DisableModify="yes" DisableRemove="yes">
    <BootstrapperApplication>
      <!-- LicenseUrl 为空：不显示许可勾选，隐私政策由 MSI 自己的界面展示 -->
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl=""
                                              LocalizationFile="$(ShellDir)\windows\bundle-zh-CN.wxl"
                                              LogoFile="$(ShellDir)\icons\64x64.png"
                                              ShowVersion="yes" SuppressOptionsUI="yes" SuppressRepair="yes" />
    </BootstrapperApplication>

    <bal:Condition Condition="VersionNT64"
                   Message="乾元 Primus 只支持 64 位 Windows（x64 或 ARM64），这台电脑是 32 位系统，无法安装。" />

    <Chain>
      <MsiPackage Id="PrimusX64" SourceFile="$(X64Msi)" Compressed="yes" Permanent="yes" Visible="yes" Cache="remove"
                  InstallCondition="NOT (NativeMachine = 43620)"
                  bal:DisplayInternalUICondition="WixBundleAction = 6">
        <MsiProperty Name="PRIMUS_BUNDLE" Value="1" />
      </MsiPackage>
<?ifdef Arm64Msi?>
      <MsiPackage Id="PrimusArm64" SourceFile="$(Arm64Msi)" Compressed="yes" Permanent="yes" Visible="yes" Cache="remove"
                  InstallCondition="NativeMachine = 43620"
                  bal:DisplayInternalUICondition="WixBundleAction = 6">
        <MsiProperty Name="PRIMUS_BUNDLE" Value="1" />
      </MsiPackage>
<?endif?>
    </Chain>
  </Bundle>
</Wix>
